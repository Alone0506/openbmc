diff --git a/drivers/hwmon/c8763.c b/drivers/hwmon/c8763.c
new file mode 100644
index 000000000000..698e9b9299a6
--- /dev/null
+++ b/drivers/hwmon/c8763.c
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <linux/err.h>
+#include <linux/hwmon.h>
+#include <linux/i2c.h>
+#include <linux/math.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+
+#define C8763_REG_TEMP 0x02
+
+/*
+ * This callback decides which sysfs files are created.
+ * 
+ * Return 0444: the read-only temp1_input file
+ * Return 0: to hide an unsupported file
+ */
+static umode_t c8763_is_visible(const void *data, enum hwmon_sensor_types type,
+				u32 attr, int channel)
+{
+	if (type == hwmon_temp && attr == hwmon_temp_input && channel == 0)
+		return 0444;
+
+	return 0;
+}
+
+/* The hwmon core calls this callback when a user reads temp1_input. */
+static int c8763_read(struct device *dev, enum hwmon_sensor_types type,
+		       u32 attr, int channel, long *val)
+{
+	struct regmap *regmap = dev_get_drvdata(dev);
+	unsigned int regval;
+	s16 raw;
+	int ret;
+
+	if (type != hwmon_temp || attr != hwmon_temp_input || channel != 0)
+		return -EOPNOTSUPP;
+
+	/* Regmap converts the big-endian value as configured below. */
+	ret = regmap_read(regmap, C8763_REG_TEMP, &regval);
+	if (ret < 0)
+		return ret;
+
+	raw = (s16)regval;
+
+	/*
+	 * Convert signed Q8.8 degrees Celsius to millidegrees Celsius.
+	 * 
+	 * For example:
+	 * raw: 0x1900 -> 25000
+	 *      0xfb80 -> -4500
+	 */
+	*val = DIV_ROUND_CLOSEST((long)raw * 1000, 256);
+
+	return 0;
+}
+
+static const struct hwmon_channel_info * const c8763_info[] = {
+	HWMON_CHANNEL_INFO(temp, HWMON_T_INPUT),
+	NULL
+};
+
+/*
+ * The hwmon core uses is_visible() when it creates sysfs files and
+ * read() when a file is read.
+ */
+static const struct hwmon_ops c8763_hwmon_ops = {
+	.is_visible = c8763_is_visible,
+	.read = c8763_read,
+};
+
+static const struct hwmon_chip_info c8763_chip_info = {
+	.ops = &c8763_hwmon_ops,
+	.info = c8763_info,
+};
+
+/*
+ * Register addresses are 8 bits wide, and register values are 16-bit
+ * big-endian numbers. Register 0x02 is the highest valid address.
+ *
+ * Ref: include/linux/regmap.h:255
+ */
+static const struct regmap_config c8763_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 16,
+	.max_register = C8763_REG_TEMP,
+	.val_format_endian = REGMAP_ENDIAN_BIG,
+};
+
+static int c8763_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct device *hwmon_dev;
+	struct regmap *regmap;
+
+	/* The managed regmap is freed when the device is removed. */
+	regmap = devm_regmap_init_i2c(client, &c8763_regmap_config);
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap),
+				     "failed to initialize regmap\n");
+
+	hwmon_dev = devm_hwmon_device_register_with_info(dev, client->name,
+							 regmap,
+							 &c8763_chip_info,
+							 NULL);
+
+	return PTR_ERR_OR_ZERO(hwmon_dev);
+}
+
+static const struct of_device_id c8763_of_match[] = {
+	{ .compatible = "kirito,c8763" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, c8763_of_match);
+
+static const struct i2c_device_id c8763_id[] = {
+	{ "c8763" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, c8763_id);
+
+static struct i2c_driver c8763_driver = {
+	.driver = {
+		.name = "c8763",
+		.of_match_table = c8763_of_match,
+	},
+	/* The I2C core calls probe after a successful match. */
+	.probe = c8763_probe,
+	.id_table = c8763_id,
+};
+module_i2c_driver(c8763_driver);
+
+MODULE_AUTHOR("Kirigaya Kazuto <kirito@kadokawa.co.jp>");
+MODULE_DESCRIPTION("Kirito C8763 temperature sensor driver");
+MODULE_LICENSE("GPL");
