diff --git a/Documentation/devicetree/bindings/hwmon/kirito,c8763.yaml b/Documentation/devicetree/bindings/hwmon/kirito,c8763.yaml
new file mode 100644
index 000000000000..1647f034ff7a
--- /dev/null
+++ b/Documentation/devicetree/bindings/hwmon/kirito,c8763.yaml
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/hwmon/Kirito,c8763.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Kirito C8763 temperature sensor
+
+maintainers:
+  - Kirigaya Kazuto <kirito@kadokawa.co.jp>
+
+description: |
+  The Kirito C8763 is an I2C temperature sensor. Its temperature register
+  contains a signed Q8.8 value in degrees Celsius.
+
+properties:
+  compatible:
+    const: kirito,c8763
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+allOf:
+  - $ref: hwmon-common.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        temperature-sensor@22 {
+            compatible = "kirito,c8763";
+            reg = <0x22>;
+        };
+    };
