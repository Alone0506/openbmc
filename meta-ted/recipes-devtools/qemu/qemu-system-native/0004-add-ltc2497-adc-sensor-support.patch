--- a/hw/sensor/meson.build
+++ b/hw/sensor/meson.build
@@ -9,3 +9,4 @@ system_ss.add(when: 'CONFIG_LSM303DLHC_MAG', if_true: files('lsm303dlhc_mag.c'))
 system_ss.add(when: 'CONFIG_ISL_PMBUS_VR', if_true: files('isl_pmbus_vr.c'))
 system_ss.add(when: 'CONFIG_MAX31785', if_true: files('max31785.c'))
 system_ss.add(when: 'CONFIG_C8763', if_true: files('c8763.c'))
+system_ss.add(when: 'CONFIG_LTC2497', if_true: files('ltc2497.c'))
diff --git a/include/hw/sensor/ltc2497.h b/include/hw/sensor/ltc2497.h
new file mode 100644
index 000000000..7d11651fb
--- /dev/null
+++ b/include/hw/sensor/ltc2497.h
@@ -0,0 +1,29 @@
+/*
+ * Analog Devices/Linear Technology LTC2497 ADC
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_SENSOR_LTC2497_H
+#define HW_SENSOR_LTC2497_H
+
+#include "hw/i2c/i2c.h"
+
+#define TYPE_LTC2497 "ltc2497"
+OBJECT_DECLARE_SIMPLE_TYPE(LTC2497State, LTC2497)
+
+#define LTC2497_NUM_INPUTS 16
+
+struct LTC2497State {
+    I2CSlave i2c;
+
+    uint32_t input_uv[LTC2497_NUM_INPUTS];
+    uint32_t common_uv;
+    uint32_t vref_uv;
+
+    uint8_t command;
+    uint8_t buf[3];
+    uint8_t pos;
+};
+
+#endif /* HW_SENSOR_LTC2497_H */
