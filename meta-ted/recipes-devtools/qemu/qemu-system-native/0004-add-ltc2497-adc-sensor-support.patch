--- a/hw/arm/aspeed_ast2600_evb.c
+++ b/hw/arm/aspeed_ast2600_evb.c
@@ -13,6 +13,7 @@
 #include "hw/arm/aspeed_soc.h"
 #include "hw/i2c/smbus_eeprom.h"
 #include "hw/sensor/c8763.h"
+#include "hw/sensor/ltc2497.h"
 #include "hw/sensor/tmp105.h"
 #include "hw/nvram/eeprom_at24c.h"
 
@@ -37,6 +38,13 @@ static const uint8_t ted_bmc_fruid[] = {
 };
 static const size_t ted_bmc_fruid_len = sizeof(ted_bmc_fruid);
 
+static const uint32_t ltc2497_inputs_uv[LTC2497_NUM_INPUTS] = {
+    1000000, 1010000, 1020000, 1030000,
+    1040000, 1050000, 1060000, 1070000,
+    1080000, 1090000, 1100000, 1110000,
+    1120000, 1130000, 1140000, 1150000,
+};
+
 static void ast2600_evb_i2c_init(AspeedMachineState *bmc)
 {
     AspeedSoCState *soc = bmc->soc;
@@ -61,6 +69,24 @@ static void ast2600_evb_i2c_init(AspeedMachineState *bmc)
     dev = DEVICE(i2c_slave_create_simple(aspeed_i2c_get_bus(&soc->i2c, 9),
                                          TYPE_C8763, 0x22));
     object_property_set_int(OBJECT(dev), "temperature", 42500, &error_abort);
+
+    I2CSlave *adc = i2c_slave_new(TYPE_LTC2497, 0x50);
+    unsigned int i;
+
+    dev = DEVICE(adc);
+    object_property_set_uint(OBJECT(dev), "vref", 3300000, &error_abort);
+    object_property_set_uint(OBJECT(dev), "common", 0, &error_abort);
+
+    for (i = 0; i < ARRAY_SIZE(ltc2497_inputs_uv); i++) {
+        g_autofree char *property = g_strdup_printf("input[%u]", i);
+
+        object_property_set_uint(OBJECT(dev), property,
+                                 ltc2497_inputs_uv[i], &error_abort);
+    }
+
+    i2c_slave_realize_and_unref(adc,
+                                aspeed_i2c_get_bus(&soc->i2c, 9),
+                                &error_abort);
 }
 
 static void aspeed_machine_ast2600_evb_class_init(ObjectClass *oc,
