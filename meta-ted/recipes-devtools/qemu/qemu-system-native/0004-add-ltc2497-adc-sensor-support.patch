diff --git a/hw/sensor/ltc2497.c b/hw/sensor/ltc2497.c
new file mode 100644
index 000000000..4a9e8fb82
--- /dev/null
+++ b/hw/sensor/ltc2497.c
@@ -0,0 +1,180 @@
+/*
+ * Analog Devices/Linear Technology LTC2497 ADC
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/sensor/ltc2497.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+#define LTC2497_ENABLE             0xa0
+#define LTC2497_SINGLE_ENDED       BIT(4)
+#define LTC2497_ODD_SIGN           BIT(3)
+#define LTC2497_CHANNEL_MASK       0x07
+#define LTC2497_OFFSET_CODE        (1 << 17)
+#define LTC2497_FULL_SCALE_CODE    (1 << 16)
+#define LTC2497_DEFAULT_VREF_UV    2500000
+
+static int64_t ltc2497_diff_uv(LTC2497State *s)
+{
+    unsigned int pair = (s->command & LTC2497_CHANNEL_MASK) * 2;
+
+    if (s->command & LTC2497_SINGLE_ENDED) {
+        unsigned int channel = pair + !!(s->command & LTC2497_ODD_SIGN);
+
+        return (int64_t)s->input_uv[channel] - s->common_uv;
+    }
+
+    if (s->command & LTC2497_ODD_SIGN) {
+        return (int64_t)s->input_uv[pair + 1] - s->input_uv[pair];
+    }
+
+    return (int64_t)s->input_uv[pair] - s->input_uv[pair + 1];
+}
+
+static int32_t ltc2497_convert(LTC2497State *s)
+{
+    int64_t input_uv = ltc2497_diff_uv(s);
+
+    if (!s->vref_uv) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: reference voltage must be nonzero\n", __func__);
+        return 0;
+    }
+
+    /* The differential full-scale range is -Vref / 2 to +Vref / 2. */
+    if (input_uv * 2 >= s->vref_uv) {
+        return LTC2497_FULL_SCALE_CODE;
+    }
+
+    if (input_uv * 2 < -(int64_t)s->vref_uv) {
+        return -LTC2497_FULL_SCALE_CODE - 1;
+    }
+
+    return input_uv * LTC2497_OFFSET_CODE / s->vref_uv;
+}
+
+static void ltc2497_prepare_result(LTC2497State *s)
+{
+    int32_t raw = ltc2497_convert(s);
+    uint32_t value = (raw + LTC2497_OFFSET_CODE) << 6;
+
+    s->buf[0] = value >> 16;
+    s->buf[1] = value >> 8;
+    s->buf[2] = value;
+    s->pos = 0;
+}
+
+static uint8_t ltc2497_rx(I2CSlave *i2c)
+{
+    LTC2497State *s = LTC2497(i2c);
+
+    if (s->pos < sizeof(s->buf)) {
+        return s->buf[s->pos++];
+    }
+
+    return 0xff;
+}
+
+static int ltc2497_tx(I2CSlave *i2c, uint8_t data)
+{
+    LTC2497State *s = LTC2497(i2c);
+
+    /* EN=1 and the mandatory control bit select commands 0xa0-0xbf. */
+    if ((data & 0xe0) != LTC2497_ENABLE) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: invalid input selection command 0x%02x\n",
+                      __func__, data);
+        return 1;
+    }
+
+    s->command = data;
+    return 0;
+}
+
+static int ltc2497_event(I2CSlave *i2c, enum i2c_event event)
+{
+    LTC2497State *s = LTC2497(i2c);
+
+    if (event == I2C_START_RECV) {
+        ltc2497_prepare_result(s);
+    }
+
+    return 0;
+}
+
+static void ltc2497_reset_enter(Object *obj, ResetType type)
+{
+    LTC2497State *s = LTC2497(obj);
+
+    s->command = LTC2497_ENABLE;
+    memset(s->buf, 0, sizeof(s->buf));
+    s->pos = 0;
+}
+
+static const VMStateDescription vmstate_ltc2497 = {
+    .name = "LTC2497",
+    .version_id = 0,
+    .minimum_version_id = 0,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(input_uv, LTC2497State, LTC2497_NUM_INPUTS),
+        VMSTATE_UINT32(common_uv, LTC2497State),
+        VMSTATE_UINT32(vref_uv, LTC2497State),
+        VMSTATE_UINT8(command, LTC2497State),
+        VMSTATE_UINT8_ARRAY(buf, LTC2497State, 3),
+        VMSTATE_UINT8(pos, LTC2497State),
+        VMSTATE_I2C_SLAVE(i2c, LTC2497State),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void ltc2497_init(Object *obj)
+{
+    LTC2497State *s = LTC2497(obj);
+    int i;
+
+    s->vref_uv = LTC2497_DEFAULT_VREF_UV;
+    s->command = LTC2497_ENABLE;
+
+    for (i = 0; i < LTC2497_NUM_INPUTS; i++) {
+        object_property_add_uint32_ptr(obj, "input[*]", &s->input_uv[i],
+                                       OBJ_PROP_FLAG_READWRITE);
+    }
+
+    object_property_add_uint32_ptr(obj, "common", &s->common_uv,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "vref", &s->vref_uv,
+                                   OBJ_PROP_FLAG_READWRITE);
+}
+
+static void ltc2497_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *sc = I2C_SLAVE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->desc = "LTC2497 16-channel ADC";
+    dc->vmsd = &vmstate_ltc2497;
+    sc->event = ltc2497_event;
+    sc->recv = ltc2497_rx;
+    sc->send = ltc2497_tx;
+    rc->phases.enter = ltc2497_reset_enter;
+}
+
+static const TypeInfo ltc2497_info = {
+    .name = TYPE_LTC2497,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(LTC2497State),
+    .instance_init = ltc2497_init,
+    .class_init = ltc2497_class_init,
+};
+
+static void ltc2497_register_types(void)
+{
+    type_register_static(&ltc2497_info);
+}
+
+type_init(ltc2497_register_types)
