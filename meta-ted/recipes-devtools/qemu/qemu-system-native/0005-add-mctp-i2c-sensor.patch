diff --git a/hw/sensor/mctp-i2c-sensor.c b/hw/sensor/mctp-i2c-sensor.c
new file mode 100644
index 000000000..fa2d15438
--- /dev/null
+++ b/hw/sensor/mctp-i2c-sensor.c
@@ -0,0 +1,865 @@
+/*
+ * Fixed-address MCTP-over-SMBus/I2C temperature sensor.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Uses the reverse-controller transfer approach from Jian Zhang's
+ * mctp-i2c-responder proposal and QEMU's i2c-echo example. SMBus ARP is
+ * deliberately absent: the bus owner must know the 7-bit I2C address.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/bswap.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "qemu/uuid.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/i2c/i2c.h"
+#include "hw/sensor/mctp-i2c-sensor.h"
+#include "migration/vmstate.h"
+
+/* DSP0237: address, command, count, source, MCTP header, payload, PEC. */
+#define MCTP_I2C_COMMAND             0x0f
+#define MCTP_PAYLOAD_MAX             64
+#define MCTP_PACKET_MAX              (8 + MCTP_PAYLOAD_MAX + 1)
+#define MCTP_TX_QUEUE_MAX            16
+#define MCTP_SOM                     0x80
+#define MCTP_EOM                     0x40
+#define MCTP_TAG_OWNER               0x08
+#define MCTP_TAG_MASK                0x07
+#define MCTP_TYPE_CONTROL            0x00
+#define MCTP_TYPE_PLDM               0x01
+#define REQUEST                     0x80
+#define DATAGRAM                    0x40
+#define INSTANCE_ID_MASK            0x1f
+
+#define MCTP_SET_EID                 0x01
+#define MCTP_GET_EID                 0x02
+#define MCTP_GET_UUID                0x03
+#define MCTP_GET_VERSION             0x04
+#define MCTP_GET_TYPES               0x05
+#define MCTP_CC_INVALID_DATA         0x02
+#define MCTP_CC_INVALID_LENGTH       0x03
+#define MCTP_CC_UNSUPPORTED          0x05
+#define MCTP_CC_UNSUPPORTED_TYPE     0x80
+#define MCTP_EID_REJECTED            0x10
+
+#define PLDM_TYPE_BASE               0x00
+#define PLDM_TYPE_PLATFORM           0x02
+#define PLDM_SET_TID                 0x01
+#define PLDM_GET_TID                 0x02
+#define PLDM_GET_VERSION             0x03
+#define PLDM_GET_TYPES               0x04
+#define PLDM_GET_COMMANDS            0x05
+#define PLDM_GET_SENSOR_READING      0x11
+#define PLDM_GET_PDR_REPOSITORY_INFO  0x50
+#define PLDM_GET_PDR                 0x51
+#define PLDM_CC_INVALID_DATA         0x02
+#define PLDM_CC_INVALID_LENGTH       0x03
+#define PLDM_CC_UNSUPPORTED          0x05
+#define PLDM_CC_INVALID_TYPE         0x20
+#define PLDM_CC_INVALID_VERSION      0x84
+#define PLDM_CC_INVALID_SENSOR_ID    0x80
+#define PLDM_CC_INVALID_TRANSFER     0x80
+#define PLDM_CC_INVALID_TRANSFER_OP  0x81
+#define PLDM_CC_INVALID_RECORD       0x82
+#define PLDM_CC_INVALID_RECORD_CHANGE 0x83
+#define PLDM_SENSOR_ID               1
+#define PLDM_TERMINUS_HANDLE         1
+#define PLDM_ENTITY_SYSTEM_BOARD     64
+#define PLDM_PDR_TERMINUS_LOCATOR    1
+#define PLDM_PDR_NUMERIC_SENSOR      2
+#define PLDM_PDR_SENSOR_NAMES        6
+#define PLDM_PDR_ENTITY_NAMES        16
+#define PLDM_PDR_COUNT               4
+#define PLDM_PDR_HEADER_SIZE         10
+#define PLDM_PDR_MAX_SIZE            78
+#define PLDM_GET_PDR_HEADER_SIZE     16
+/* Reserve one byte for the CRC on the last part of a multipart transfer. */
+#define PLDM_PDR_CHUNK_MAX           (MCTP_PAYLOAD_MAX - \
+                                     PLDM_GET_PDR_HEADER_SIZE - 1)
+#define PLDM_GET_NEXT_PART           0
+#define PLDM_GET_FIRST_PART          1
+#define PLDM_TRANSFER_START          0
+#define PLDM_TRANSFER_MIDDLE         1
+#define PLDM_TRANSFER_END            4
+#define PLDM_TRANSFER_START_AND_END  5
+
+OBJECT_DECLARE_SIMPLE_TYPE(MCTPI2CSensorState, MCTP_I2C_SENSOR)
+
+typedef struct MCTPSensorPacket {
+    uint8_t data[MCTP_PACKET_MAX];
+    unsigned int len;
+    unsigned int pos;
+} MCTPSensorPacket;
+
+struct MCTPI2CSensorState {
+    I2CSlave parent_obj;
+
+    uint8_t initial_eid;
+    uint8_t eid;
+    uint8_t tid;
+    uint16_t pdr_change_num;
+    QemuUUID uuid;
+    int32_t temperature; /* milli-degrees Celsius */
+
+    I2CBus *bus;
+    QEMUBH *tx_bh;
+    GQueue tx_queue;
+    bool tx_pending;
+    uint8_t rx[MCTP_PACKET_MAX];
+    unsigned int rx_len;
+    bool rx_overflow;
+};
+
+static uint8_t mctp_sensor_pec(const uint8_t *buf, size_t len)
+{
+    uint8_t crc = 0;
+
+    for (size_t i = 0; i < len; i++) {
+        crc ^= buf[i];
+        for (unsigned int bit = 0; bit < 8; bit++) {
+            crc = (crc << 1) ^ ((crc & 0x80) ? 0x07 : 0);
+        }
+    }
+    return crc;
+}
+
+static bool mctp_sensor_valid_eid(uint8_t eid)
+{
+    return eid >= 8 && eid < 0xff;
+}
+
+static void pldm_sensor_pdr_changed(MCTPI2CSensorState *s)
+{
+    s->pdr_change_num = s->pdr_change_num == UINT16_MAX ?
+                        1 : s->pdr_change_num + 1;
+}
+
+/* Payloads include the MCTP message-type byte. */
+static size_t mctp_sensor_control(MCTPI2CSensorState *s,
+                                  const uint8_t *req, size_t len, uint8_t *rsp)
+{
+    size_t expected;
+    uint8_t old_eid = s->eid;
+
+    if (len < 3 || !(req[1] & REQUEST) || (req[1] & DATAGRAM)) {
+        return 0;
+    }
+
+    rsp[0] = MCTP_TYPE_CONTROL;
+    rsp[1] = req[1] & INSTANCE_ID_MASK;
+    rsp[2] = req[2];
+    rsp[3] = 0;
+
+    switch (req[2]) {
+    case MCTP_SET_EID:
+        expected = 5;
+        break;
+    case MCTP_GET_VERSION:
+        expected = 4;
+        break;
+    case MCTP_GET_EID:
+    case MCTP_GET_UUID:
+    case MCTP_GET_TYPES:
+        expected = 3;
+        break;
+    default:
+        rsp[3] = MCTP_CC_UNSUPPORTED;
+        return 4;
+    }
+    if (len != expected) {
+        rsp[3] = MCTP_CC_INVALID_LENGTH;
+        return 4;
+    }
+
+    switch (req[2]) {
+    case MCTP_SET_EID:
+        if (req[3] > 3 ||
+            ((req[3] == 0 || req[3] == 1) &&
+             !mctp_sensor_valid_eid(req[4]))) {
+            rsp[3] = MCTP_CC_INVALID_DATA;
+            return 4;
+        }
+        rsp[4] = 0; /* Assignment accepted; no EID pool requested. */
+        switch (req[3]) {
+        case 0: /* Set EID: keep an EID already assigned by a bus owner. */
+            if (s->eid && s->eid != req[4]) {
+                rsp[4] = MCTP_EID_REJECTED;
+                break;
+            }
+            s->eid = req[4];
+            break;
+        case 1: /* Force EID */
+            s->eid = req[4];
+            break;
+        case 2: /* Reset EID */
+            s->eid = s->initial_eid;
+            break;
+        case 3: /* Set Discovered Flag: no EID change on this endpoint. */
+            break;
+        }
+        if (s->eid != old_eid) {
+            pldm_sensor_pdr_changed(s);
+        }
+        rsp[5] = s->eid;
+        rsp[6] = 0;
+        return 7;
+
+    case MCTP_GET_EID:
+        rsp[4] = s->eid;
+        rsp[5] = 0; /* Simple endpoint, dynamic EID, no static EID. */
+        rsp[6] = 0; /* No medium-specific information. */
+        return 7;
+
+    case MCTP_GET_UUID:
+        memcpy(rsp + 4, s->uuid.data, sizeof(s->uuid.data));
+        return 4 + sizeof(s->uuid.data);
+
+    case MCTP_GET_VERSION:
+        if (req[3] != 0xff && req[3] != MCTP_TYPE_CONTROL &&
+            req[3] != MCTP_TYPE_PLDM) {
+            rsp[3] = MCTP_CC_UNSUPPORTED_TYPE;
+            return 4;
+        }
+        rsp[4] = 1; /* One complete four-byte version entry, in BCD. */
+        rsp[5] = 0xf1;
+        rsp[6] = req[3] == MCTP_TYPE_PLDM ? 0xf0 : 0xf3;
+        rsp[7] = 0xf0;
+        rsp[8] = 0;
+        return 9;
+
+    case MCTP_GET_TYPES:
+        rsp[4] = 2;
+        rsp[5] = MCTP_TYPE_CONTROL;
+        rsp[6] = MCTP_TYPE_PLDM;
+        return 7;
+    }
+    g_assert_not_reached();
+}
+
+static bool pldm_sensor_valid_type(uint8_t type)
+{
+    return type == PLDM_TYPE_BASE || type == PLDM_TYPE_PLATFORM;
+}
+
+static uint32_t pldm_sensor_version_crc(const uint8_t *buf, size_t len)
+{
+    uint32_t crc = UINT32_MAX;
+
+    for (size_t i = 0; i < len; i++) {
+        crc ^= buf[i];
+        for (unsigned int bit = 0; bit < 8; bit++) {
+            crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320 : 0);
+        }
+    }
+    return ~crc;
+}
+
+/* All names in this virtual device are ASCII, encoded as PLDM UTF-16BE. */
+static size_t pldm_sensor_pdr_name(uint8_t *data, const char *name)
+{
+    size_t len = strlen(name);
+
+    for (size_t i = 0; i <= len; i++) {
+        stw_be_p(data + 2 * i, (uint8_t)name[i]);
+    }
+    return 2 * (len + 1);
+}
+
+static size_t pldm_sensor_pdr(MCTPI2CSensorState *s, uint32_t handle,
+                            uint8_t *pdr)
+{
+    size_t len;
+    char name[sizeof("QEMU_MCTP_00")];
+
+    memset(pdr, 0, PLDM_PDR_MAX_SIZE);
+    switch (handle) {
+    case 1:
+        len = 19;
+        pdr[5] = PLDM_PDR_TERMINUS_LOCATOR;
+        stw_le_p(pdr + 10, PLDM_TERMINUS_HANDLE);
+        pdr[12] = s->eid != 0; /* Locator validity */
+        pdr[13] = s->tid;
+        pdr[16] = 1; /* MCTP_EID locator type */
+        pdr[17] = 1; /* Locator value size */
+        pdr[18] = s->eid;
+        break;
+    case 2:
+        len = PLDM_PDR_MAX_SIZE;
+        pdr[5] = PLDM_PDR_NUMERIC_SENSOR;
+        stw_le_p(pdr + 10, PLDM_TERMINUS_HANDLE);
+        stw_le_p(pdr + 12, PLDM_SENSOR_ID);
+        stw_le_p(pdr + 14, PLDM_ENTITY_SYSTEM_BOARD);
+        stw_le_p(pdr + 16, 1); /* Entity instance */
+        /* sensorInit = noInit; the sensor is always enabled. */
+        pdr[21] = 1; /* Sensor Auxiliary Names PDR present */
+        pdr[22] = 2; /* Degrees Celsius */
+        pdr[23] = (uint8_t)-3; /* Raw readings are milli-degrees Celsius. */
+        pdr[31] = 1; /* Linear reading conversion */
+        pdr[32] = 5; /* sint32 sensorDataSize */
+        stl_le_p(pdr + 33, 0x3f800000); /* resolution = 1.0 */
+        stl_le_p(pdr + 55, 0x3f800000); /* updateInterval = 1.0 second */
+        stl_le_p(pdr + 59, 128000); /* maxReadable */
+        stl_le_p(pdr + 63, (uint32_t)-127000); /* minReadable */
+        /* No thresholds/ranges; rangeFieldFormat = uint8, values = zero. */
+        break;
+    case 3:
+        pdr[5] = PLDM_PDR_SENSOR_NAMES;
+        stw_le_p(pdr + 10, PLDM_TERMINUS_HANDLE);
+        stw_le_p(pdr + 12, PLDM_SENSOR_ID);
+        pdr[14] = 1; /* Sensor count */
+        pdr[15] = 1; /* Name string count */
+        memcpy(pdr + 16, "en", 3);
+        len = 19 + pldm_sensor_pdr_name(pdr + 19, "Temperature");
+        break;
+    case 4:
+        pdr[5] = PLDM_PDR_ENTITY_NAMES;
+        stw_le_p(pdr + 10, PLDM_ENTITY_SYSTEM_BOARD);
+        stw_le_p(pdr + 12, 1); /* Entity instance; system container is zero. */
+        pdr[17] = 1; /* Name string count */
+        memcpy(pdr + 18, "en", 3);
+        snprintf(name, sizeof(name), "QEMU_MCTP_%02x", s->parent_obj.address);
+        len = 21 + pldm_sensor_pdr_name(pdr + 21, name);
+        break;
+    default:
+        return 0;
+    }
+
+    stl_le_p(pdr, handle);
+    pdr[4] = 1; /* PDR header version */
+    stw_le_p(pdr + 6, s->pdr_change_num);
+    stw_le_p(pdr + 8, len - PLDM_PDR_HEADER_SIZE);
+    return len;
+}
+
+static uint32_t pldm_sensor_transfer_handle(MCTPI2CSensorState *s,
+                                          uint32_t record, size_t offset)
+{
+    /* Bind a continuation to this record and repository generation. */
+    return (record << 24) | ((uint32_t)s->pdr_change_num << 8) | offset;
+}
+
+static size_t pldm_sensor_get_pdr(MCTPI2CSensorState *s, const uint8_t *req,
+                                uint8_t *rsp)
+{
+    uint32_t record = ldl_le_p(req + 4);
+    uint32_t transfer = ldl_le_p(req + 8);
+    uint8_t op = req[12];
+    uint16_t count = lduw_le_p(req + 13);
+    uint16_t change = lduw_le_p(req + 15);
+    uint8_t pdr[PLDM_PDR_MAX_SIZE];
+    size_t offset = 0, len;
+    bool last;
+
+    /* Record handle zero identifies the first record, also on continuations. */
+    if (!record) {
+        record = 1;
+    }
+    len = pldm_sensor_pdr(s, record, pdr);
+    if (!len) {
+        rsp[4] = PLDM_CC_INVALID_RECORD;
+        return 5;
+    }
+    if (op != PLDM_GET_FIRST_PART && op != PLDM_GET_NEXT_PART) {
+        rsp[4] = PLDM_CC_INVALID_TRANSFER_OP;
+        return 5;
+    }
+    if ((op == PLDM_GET_FIRST_PART && change != 0) ||
+        (op == PLDM_GET_NEXT_PART && change != s->pdr_change_num)) {
+        rsp[4] = PLDM_CC_INVALID_RECORD_CHANGE;
+        return 5;
+    }
+    if (op == PLDM_GET_FIRST_PART) {
+        if (transfer) {
+            rsp[4] = PLDM_CC_INVALID_TRANSFER;
+            return 5;
+        }
+    } else {
+        offset = transfer & 0xff;
+        if (!offset || offset >= len ||
+            transfer != pldm_sensor_transfer_handle(s, record, offset)) {
+            rsp[4] = PLDM_CC_INVALID_TRANSFER;
+            return 5;
+        }
+    }
+
+    count = MIN(count, MIN(len - offset, PLDM_PDR_CHUNK_MAX));
+    /* A zero requestCount is a metadata-only probe, with no continuation. */
+    last = !count || offset + count == len;
+    stl_le_p(rsp + 5, record == PLDM_PDR_COUNT ? 0 : record + 1);
+    stl_le_p(rsp + 9, last ? 0 :
+             pldm_sensor_transfer_handle(s, record, offset + count));
+    rsp[13] = op == PLDM_GET_FIRST_PART ?
+              (last ? PLDM_TRANSFER_START_AND_END : PLDM_TRANSFER_START) :
+              (last ? PLDM_TRANSFER_END : PLDM_TRANSFER_MIDDLE);
+    stw_le_p(rsp + 14, count);
+    memcpy(rsp + PLDM_GET_PDR_HEADER_SIZE, pdr + offset, count);
+    len = PLDM_GET_PDR_HEADER_SIZE + count;
+    if (rsp[13] == PLDM_TRANSFER_END) {
+        rsp[len++] = mctp_sensor_pec(pdr, lduw_le_p(pdr + 8) +
+                                    PLDM_PDR_HEADER_SIZE);
+    }
+    return len;
+}
+
+static size_t pldm_sensor_platform(MCTPI2CSensorState *s, const uint8_t *req,
+                                 size_t len, uint8_t *rsp)
+{
+    size_t expected;
+
+    switch (req[3]) {
+    case PLDM_GET_SENSOR_READING:
+        expected = 7;
+        break;
+    case PLDM_GET_PDR_REPOSITORY_INFO:
+        expected = 4;
+        break;
+    case PLDM_GET_PDR:
+        expected = 17;
+        break;
+    default:
+        rsp[4] = PLDM_CC_UNSUPPORTED;
+        return 5;
+    }
+    if (len != expected) {
+        rsp[4] = PLDM_CC_INVALID_LENGTH;
+        return 5;
+    }
+
+    switch (req[3]) {
+    case PLDM_GET_PDR_REPOSITORY_INFO: {
+        uint8_t pdr[PLDM_PDR_MAX_SIZE];
+        uint32_t size = 0, largest = 0;
+
+        for (uint32_t handle = 1; handle <= PLDM_PDR_COUNT; handle++) {
+            size_t pdr_len = pldm_sensor_pdr(s, handle, pdr);
+            size += pdr_len;
+            largest = MAX(largest, pdr_len);
+        }
+        /* Available repository; unspecified timestamps; no transfer timeout. */
+        memset(rsp + 5, 0, 40);
+        stl_le_p(rsp + 32, PLDM_PDR_COUNT);
+        stl_le_p(rsp + 36, size);
+        stl_le_p(rsp + 40, largest);
+        return 45;
+    }
+    case PLDM_GET_PDR:
+        return pldm_sensor_get_pdr(s, req, rsp);
+    case PLDM_GET_SENSOR_READING:
+        if (lduw_le_p(req + 4) != PLDM_SENSOR_ID) {
+            rsp[4] = PLDM_CC_INVALID_SENSOR_ID;
+            return 5;
+        }
+        if (req[6] > 1) {
+            rsp[4] = PLDM_CC_INVALID_DATA;
+            return 5;
+        }
+        rsp[5] = 5; /* sensorDataSize: sint32. */
+        rsp[6] = 0; /* sensorOperationalState: enabled. */
+        rsp[7] = 0; /* sensorEventMessageEnable: no event generation. */
+        rsp[8] = 1; /* presentState: normal. */
+        rsp[9] = 1; /* previousState: normal. */
+        rsp[10] = 1; /* eventState: normal. */
+        stl_le_p(rsp + 11, s->temperature);
+        return 15;
+    }
+    g_assert_not_reached();
+}
+
+static size_t mctp_sensor_pldm(MCTPI2CSensorState *s,
+                               const uint8_t *req, size_t len, uint8_t *rsp)
+{
+    /* DSP0240 version fields are little endian: alpha, update, minor, major. */
+    static const uint8_t version[] = { 0x00, 0xf0, 0xf0, 0xf1 };
+    size_t expected;
+
+    if (len < 4 || !(req[1] & REQUEST) || (req[1] & DATAGRAM) ||
+        (req[2] & 0xc0)) {
+        return 0;
+    }
+    rsp[0] = MCTP_TYPE_PLDM;
+    rsp[1] = req[1] & INSTANCE_ID_MASK;
+    rsp[2] = req[2];
+    rsp[3] = req[3];
+    rsp[4] = 0;
+
+    if (!pldm_sensor_valid_type(req[2])) {
+        rsp[4] = PLDM_CC_INVALID_TYPE;
+        return 5;
+    }
+
+    if (req[2] == PLDM_TYPE_PLATFORM) {
+        return pldm_sensor_platform(s, req, len, rsp);
+    }
+
+    switch (req[3]) {
+    case PLDM_SET_TID:
+        expected = 5;
+        break;
+    case PLDM_GET_TID:
+    case PLDM_GET_TYPES:
+        expected = 4;
+        break;
+    case PLDM_GET_VERSION:
+        expected = 10;
+        break;
+    case PLDM_GET_COMMANDS:
+        expected = 9;
+        break;
+    default:
+        rsp[4] = PLDM_CC_UNSUPPORTED;
+        return 5;
+    }
+    if (len != expected) {
+        rsp[4] = PLDM_CC_INVALID_LENGTH;
+        return 5;
+    }
+
+    switch (req[3]) {
+    case PLDM_SET_TID:
+        if (req[4] == 0 || req[4] == 0xff) {
+            rsp[4] = PLDM_CC_INVALID_DATA;
+        } else if (s->tid != req[4]) {
+            s->tid = req[4];
+            pldm_sensor_pdr_changed(s);
+        }
+        return 5;
+
+    case PLDM_GET_TID:
+        rsp[5] = s->tid;
+        return 6;
+
+    case PLDM_GET_TYPES:
+        memset(rsp + 5, 0, 8);
+        rsp[5] = BIT(PLDM_TYPE_BASE) | BIT(PLDM_TYPE_PLATFORM);
+        return 13;
+
+    case PLDM_GET_VERSION:
+        if (!pldm_sensor_valid_type(req[9])) {
+            rsp[4] = 0x83; /* Invalid PLDM type in request data. */
+            return 5;
+        }
+        if (ldl_le_p(req + 4) != 0) {
+            rsp[4] = 0x80; /* Invalid data transfer handle. */
+            return 5;
+        }
+        if (req[8] != 1) {
+            rsp[4] = 0x81; /* Invalid transfer operation flag. */
+            return 5;
+        }
+        stl_le_p(rsp + 5, 0); /* nextDataTransferHandle */
+        rsp[9] = 5; /* transferFlag: StartAndEnd. */
+        memcpy(rsp + 10, version, sizeof(version));
+        stl_le_p(rsp + 14, pldm_sensor_version_crc(version, sizeof(version)));
+        return 18;
+
+    case PLDM_GET_COMMANDS:
+        if (!pldm_sensor_valid_type(req[4])) {
+            rsp[4] = 0x83;
+            return 5;
+        }
+        if (memcmp(req + 5, version, sizeof(version))) {
+            rsp[4] = PLDM_CC_INVALID_VERSION;
+            return 5;
+        }
+        memset(rsp + 5, 0, 32);
+        if (req[4] == PLDM_TYPE_BASE) {
+            rsp[5] = BIT(PLDM_SET_TID) | BIT(PLDM_GET_TID) |
+                     BIT(PLDM_GET_VERSION) | BIT(PLDM_GET_TYPES) |
+                     BIT(PLDM_GET_COMMANDS);
+        } else {
+            rsp[5 + PLDM_GET_SENSOR_READING / 8] =
+                BIT(PLDM_GET_SENSOR_READING % 8);
+            rsp[5 + PLDM_GET_PDR_REPOSITORY_INFO / 8] |=
+                BIT(PLDM_GET_PDR_REPOSITORY_INFO % 8);
+            rsp[5 + PLDM_GET_PDR / 8] |= BIT(PLDM_GET_PDR % 8);
+        }
+        return 37;
+    }
+    g_assert_not_reached();
+}
+
+static void mctp_sensor_schedule_tx(MCTPI2CSensorState *s)
+{
+    if (!s->tx_pending && !g_queue_is_empty(&s->tx_queue)) {
+        s->tx_pending = true;
+        i2c_bus_master(s->bus, s->tx_bh);
+        i2c_schedule_pending_master(s->bus);
+    }
+}
+
+static void mctp_sensor_tx(void *opaque)
+{
+    MCTPI2CSensorState *s = opaque;
+    MCTPSensorPacket *pkt = g_queue_peek_head(&s->tx_queue);
+
+    assert(pkt && s->bus->bh == s->tx_bh);
+    if (pkt->pos == 0) {
+        pkt->pos++;
+        if (!i2c_start_send_async(s->bus, pkt->data[0] >> 1)) {
+            return; /* Resume after the receiving controller acknowledges. */
+        }
+    } else if (pkt->pos < pkt->len) {
+        if (!i2c_send_async(s->bus, pkt->data[pkt->pos++])) {
+            return;
+        }
+    }
+
+    g_free(g_queue_pop_head(&s->tx_queue));
+    i2c_end_transfer(s->bus);
+    i2c_bus_release(s->bus);
+    s->tx_pending = false;
+    mctp_sensor_schedule_tx(s);
+}
+
+static void mctp_sensor_receive(MCTPI2CSensorState *s)
+{
+    const uint8_t *rx = s->rx;
+    uint8_t payload[MCTP_PAYLOAD_MAX];
+    size_t len;
+    MCTPSensorPacket *pkt;
+
+    if (s->rx_overflow || s->rx_len < 10 || rx[1] != MCTP_I2C_COMMAND ||
+        rx[2] < 6 || rx[2] + 4 != s->rx_len || !(rx[3] & 1) ||
+        mctp_sensor_pec(rx, s->rx_len - 1) != rx[s->rx_len - 1] ||
+        rx[4] != 1 || (rx[5] != 0 && rx[5] != s->eid) ||
+        (rx[7] & (MCTP_SOM | MCTP_EOM | MCTP_TAG_OWNER)) !=
+        (MCTP_SOM | MCTP_EOM | MCTP_TAG_OWNER) ||
+        g_queue_get_length(&s->tx_queue) >= MCTP_TX_QUEUE_MAX) {
+        return;
+    }
+
+    /* Only complete single-packet requests (up to 64 payload bytes). */
+    switch (rx[8]) {
+    case MCTP_TYPE_CONTROL:
+        len = mctp_sensor_control(s, rx + 8, s->rx_len - 9, payload);
+        break;
+    case MCTP_TYPE_PLDM:
+        len = mctp_sensor_pldm(s, rx + 8, s->rx_len - 9, payload);
+        break;
+    default:
+        return;
+    }
+    if (!len) {
+        return;
+    }
+
+    pkt = g_new0(MCTPSensorPacket, 1);
+    pkt->data[0] = rx[3] & 0xfe; /* Requester's I2C address, write direction. */
+    pkt->data[1] = MCTP_I2C_COMMAND;
+    pkt->data[2] = 5 + len;
+    pkt->data[3] = (s->parent_obj.address << 1) | 1;
+    pkt->data[4] = 1;
+    pkt->data[5] = rx[6]; /* Destination EID is the requester's source EID. */
+    /* Use the assigned EID, including for the Set EID response. */
+    pkt->data[6] = s->eid;
+    pkt->data[7] = MCTP_SOM | MCTP_EOM | (rx[7] & MCTP_TAG_MASK);
+    memcpy(pkt->data + 8, payload, len);
+    pkt->len = 8 + len;
+    pkt->data[pkt->len] = mctp_sensor_pec(pkt->data, pkt->len);
+    pkt->len++;
+    g_queue_push_tail(&s->tx_queue, pkt);
+    mctp_sensor_schedule_tx(s);
+}
+
+static int mctp_sensor_event(I2CSlave *i2c, enum i2c_event event)
+{
+    MCTPI2CSensorState *s = MCTP_I2C_SENSOR(i2c);
+
+    switch (event) {
+    case I2C_START_SEND:
+        s->rx[0] = i2c->address << 1;
+        s->rx_len = 1;
+        s->rx_overflow = false;
+        return 0;
+    case I2C_FINISH:
+        mctp_sensor_receive(s);
+        s->rx_len = 0;
+        return 0;
+    default:
+        /* DSP0237 replies use a separate write, rather than an I2C read. */
+        s->rx_len = 0;
+        return -1;
+    }
+}
+
+static int mctp_sensor_send(I2CSlave *i2c, uint8_t data)
+{
+    MCTPI2CSensorState *s = MCTP_I2C_SENSOR(i2c);
+
+    if (s->rx_len >= sizeof(s->rx)) {
+        s->rx_overflow = true;
+        return -1;
+    }
+    s->rx[s->rx_len++] = data;
+    return 0;
+}
+
+static void mctp_sensor_cancel_tx(MCTPI2CSensorState *s)
+{
+    I2CPendingMaster *node, *next;
+
+    if (!s->bus) {
+        return;
+    }
+    qemu_bh_cancel(s->tx_bh);
+    QSIMPLEQ_FOREACH_SAFE(node, &s->bus->pending_masters, entry, next) {
+        if (node->bh == s->tx_bh) {
+            QSIMPLEQ_REMOVE(&s->bus->pending_masters, node,
+                           I2CPendingMaster, entry);
+            g_free(node);
+        }
+    }
+    if (s->bus->bh == s->tx_bh) {
+        i2c_end_transfer(s->bus);
+        i2c_bus_release(s->bus);
+    }
+    g_queue_clear_full(&s->tx_queue, g_free);
+    s->tx_pending = false;
+}
+
+static void mctp_sensor_reset(DeviceState *dev)
+{
+    MCTPI2CSensorState *s = MCTP_I2C_SENSOR(dev);
+
+    mctp_sensor_cancel_tx(s);
+    s->rx_len = 0;
+    s->rx_overflow = false;
+    s->eid = s->initial_eid;
+    s->tid = 1;
+    s->pdr_change_num = 1;
+}
+
+static int mctp_sensor_pre_save(void *opaque)
+{
+    MCTPI2CSensorState *s = opaque;
+
+    /* The I2C asynchronous API does not migrate pending transfers. */
+    return s->tx_pending || s->rx_len ? -EBUSY : 0;
+}
+
+static const VMStateDescription vmstate_mctp_sensor = {
+    .name = TYPE_MCTP_I2C_SENSOR,
+    .version_id = 2,
+    .minimum_version_id = 1,
+    .pre_save = mctp_sensor_pre_save,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, MCTPI2CSensorState),
+        VMSTATE_UINT8(eid, MCTPI2CSensorState),
+        VMSTATE_UINT8(tid, MCTPI2CSensorState),
+        VMSTATE_UINT16_V(pdr_change_num, MCTPI2CSensorState, 2),
+        VMSTATE_INT32(temperature, MCTPI2CSensorState),
+        VMSTATE_UINT8_ARRAY(uuid.data, MCTPI2CSensorState, 16),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mctp_sensor_get_temperature(Object *obj, Visitor *v,
+                                       const char *name, void *opaque,
+                                       Error **errp)
+{
+    int64_t value = MCTP_I2C_SENSOR(obj)->temperature;
+
+    visit_type_int(v, name, &value, errp);
+}
+
+static void mctp_sensor_set_temperature(Object *obj, Visitor *v,
+                                       const char *name, void *opaque,
+                                       Error **errp)
+{
+    int64_t value;
+
+    if (!visit_type_int(v, name, &value, errp)) {
+        return;
+    }
+    if (value < -273150 || value > INT32_MAX) {
+        error_setg(errp, "temperature must be between -273150 and %d mC",
+                   INT32_MAX);
+        return;
+    }
+    MCTP_I2C_SENSOR(obj)->temperature = value;
+}
+
+static void mctp_sensor_realize(DeviceState *dev, Error **errp)
+{
+    MCTPI2CSensorState *s = MCTP_I2C_SENSOR(dev);
+
+    if (s->initial_eid && !mctp_sensor_valid_eid(s->initial_eid)) {
+        error_setg(errp, "initial-eid must be zero or between 8 and 254");
+        return;
+    }
+    if (s->parent_obj.address < 0x08 || s->parent_obj.address > 0x77 ||
+        s->parent_obj.address == 0x61) {
+        error_setg(errp, "address must be a non-reserved 7-bit I2C address "
+                   "other than the SMBus ARP address 0x61");
+        return;
+    }
+    if (qemu_uuid_is_null(&s->uuid)) {
+        qemu_uuid_generate(&s->uuid);
+    }
+    s->bus = I2C_BUS(qdev_get_parent_bus(dev));
+    s->tx_bh = qemu_bh_new(mctp_sensor_tx, s);
+    mctp_sensor_reset(dev);
+}
+
+static void mctp_sensor_unrealize(DeviceState *dev)
+{
+    MCTPI2CSensorState *s = MCTP_I2C_SENSOR(dev);
+
+    mctp_sensor_cancel_tx(s);
+    qemu_bh_delete(s->tx_bh);
+    s->tx_bh = NULL;
+    s->bus = NULL;
+}
+
+static void mctp_sensor_init(Object *obj)
+{
+    MCTPI2CSensorState *s = MCTP_I2C_SENSOR(obj);
+
+    s->temperature = 35000;
+    s->pdr_change_num = 1;
+    g_queue_init(&s->tx_queue);
+    object_property_add(obj, "temperature", "int",
+                        mctp_sensor_get_temperature,
+                        mctp_sensor_set_temperature, NULL, NULL);
+    object_property_add_uint8_ptr(obj, "eid", &s->eid, OBJ_PROP_FLAG_READ);
+}
+
+static const Property mctp_sensor_properties[] = {
+    DEFINE_PROP_UINT8("initial-eid", MCTPI2CSensorState, initial_eid, 0),
+    DEFINE_PROP_UUID("uuid", MCTPI2CSensorState, uuid),
+};
+
+static void mctp_sensor_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    I2CSlaveClass *sc = I2C_SLAVE_CLASS(oc);
+
+    dc->desc = "MCTP over I2C PLDM temperature sensor (no SMBus ARP)";
+    dc->realize = mctp_sensor_realize;
+    dc->unrealize = mctp_sensor_unrealize;
+    dc->vmsd = &vmstate_mctp_sensor;
+    device_class_set_legacy_reset(dc, mctp_sensor_reset);
+    device_class_set_props(dc, mctp_sensor_properties);
+    sc->event = mctp_sensor_event;
+    sc->send = mctp_sensor_send;
+}
+
+static const TypeInfo mctp_sensor_info = {
+    .name = TYPE_MCTP_I2C_SENSOR,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(MCTPI2CSensorState),
+    .instance_init = mctp_sensor_init,
+    .class_init = mctp_sensor_class_init,
+};
+
+static void mctp_sensor_register_types(void)
+{
+    type_register_static(&mctp_sensor_info);
+}
