+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Exercise the DSP0237 wire format through the AST2600 I2C controller. */
+
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "hw/i2c/aspeed_i2c.h"
+#include "libqtest.h"
+#include "qobject/qdict.h"
+
+#define I2C_BASE  0x1e78a280 /* AST2600 I2C bus 4. */
+#define SENSOR_ADDR 0x1d
+#define BMC_ADDR 0x10
+#define SENSOR_PATH "/machine/peripheral/mctp-test"
+
+static uint8_t pec(const uint8_t *data, size_t len)
+{
+    uint8_t crc = 0;
+
+    while (len--) {
+        crc ^= *data++;
+        for (int bit = 0; bit < 8; bit++) {
+            crc = (crc & 0x80) ? (crc << 1) ^ 0x07 : crc << 1;
+        }
+    }
+    return crc;
+}
+
+static uint32_t read_reg(QTestState *qts, uint32_t offset)
+{
+    return qtest_readl(qts, I2C_BASE + offset);
+}
+
+static void write_reg(QTestState *qts, uint32_t offset, uint32_t value)
+{
+    qtest_writel(qts, I2C_BASE + offset, value);
+}
+
+static void wait_status(QTestState *qts, uint32_t mask)
+{
+    for (int i = 0; i < 1000; i++) {
+        if (read_reg(qts, A_I2CD_INTR_STS) & mask) {
+            return;
+        }
+        qtest_clock_step(qts, 10000);
+    }
+    g_error("I2C interrupt 0x%x did not arrive (status 0x%x)",
+            mask, read_reg(qts, A_I2CD_INTR_STS));
+}
+
+static QTestState *sensor_init(void)
+{
+    QTestState *qts = qtest_init(
+        "-machine ast2600-evb "
+        "-device mctp-i2c-sensor,bus=aspeed.i2c.bus.4,address=0x1e,"
+        "id=mctp-test,uuid=8af8149a-76ee-4aa1-b042-19a609ff1d01");
+
+    /* Test the board's sensor at 0x1d; the explicit device is for QOM tests. */
+    write_reg(qts, A_I2CD_DEV_ADDR, BMC_ADDR);
+    write_reg(qts, A_I2CD_INTR_CTRL, 0x7fff);
+    write_reg(qts, A_I2CD_FUN_CTRL, 3); /* Enable master and slave modes. */
+    return qts;
+}
+
+static void send_packet(QTestState *qts, const uint8_t *data, size_t len)
+{
+    write_reg(qts, A_I2CD_INTR_STS, 0x7fff);
+    write_reg(qts, A_I2CD_BYTE_BUF, data[0]);
+    write_reg(qts, A_I2CD_CMD, A_I2CD_M_START_CMD | A_I2CD_M_TX_CMD);
+    g_assert_false(read_reg(qts, A_I2CD_INTR_STS) & BIT(1)); /* TX_NAK */
+    for (size_t i = 1; i < len; i++) {
+        write_reg(qts, A_I2CD_INTR_STS, BIT(0));
+        write_reg(qts, A_I2CD_BYTE_BUF, data[i]);
+        write_reg(qts, A_I2CD_CMD, A_I2CD_M_TX_CMD);
+        g_assert_false(read_reg(qts, A_I2CD_INTR_STS) & BIT(1));
+    }
+    write_reg(qts, A_I2CD_INTR_STS, 0x7fff);
+    write_reg(qts, A_I2CD_CMD, A_I2CD_M_STOP_CMD);
+}
+
+static size_t receive_packet(QTestState *qts, uint8_t addr, uint8_t *data)
+{
+    size_t len = 3;
+
+    /* Slave receive includes the destination I2C address byte. */
+    for (size_t i = 0; i < len; i++) {
+        wait_status(qts, BIT(2)); /* RX_DONE */
+        data[i] = read_reg(qts, A_I2CD_BYTE_BUF) >> 8;
+        if (i == 2) {
+            len = data[2] + 4;
+            g_assert_cmpuint(len, <=, 73);
+        }
+        write_reg(qts, A_I2CD_INTR_STS, BIT(2) | BIT(4) | BIT(7));
+    }
+    wait_status(qts, BIT(4)); /* NORMAL_STOP after the PEC was acknowledged. */
+    g_assert_cmphex(data[0], ==, BMC_ADDR << 1);
+    g_assert_cmphex(data[1], ==, 0x0f);
+    g_assert_cmphex(data[3], ==, (addr << 1) | 1);
+    g_assert_cmphex(data[4], ==, 1);
+    g_assert_cmphex(data[5], ==, 8);
+    g_assert_cmphex(data[7], ==, 0xc5); /* SOM, EOM, tag 5, TO cleared. */
+    g_assert_cmphex(data[len - 1], ==, pec(data, len - 1));
+    return len;
+}
+
+static size_t request(QTestState *qts, uint8_t addr, uint8_t eid,
+                      const uint8_t *payload, size_t payload_len, uint8_t *rsp)
+{
+    uint8_t pkt[73] = {
+        addr << 1, 0x0f, 5 + payload_len, (BMC_ADDR << 1) | 1,
+        1, eid, 8, 0xcd,
+    };
+
+    memcpy(pkt + 8, payload, payload_len);
+    pkt[8 + payload_len] = pec(pkt, 8 + payload_len);
+    send_packet(qts, pkt, 9 + payload_len);
+    return receive_packet(qts, addr, rsp);
+}
+
+static void test_setup_endpoint(void)
+{
+    QTestState *qts = sensor_init();
+    uint8_t rsp[73], uuid[16];
+    const uint8_t get_eid[] = { 0, 0x83, 2 };
+    const uint8_t set_eid[] = { 0, 0x84, 1, 0, 9 };
+    const uint8_t get_types[] = { 0, 0x85, 5 };
+    const uint8_t get_uuid[] = { 0, 0x86, 3 };
+    const uint8_t get_version[] = { 0, 0x87, 4, 0xff };
+
+    /* The same sequence used by mctpd's SetupEndpoint(ay [0x1d]). */
+    g_assert_cmpuint(request(qts, SENSOR_ADDR, 0, get_eid,
+                            sizeof(get_eid), rsp), ==, 16);
+    g_assert_cmphex(rsp[6], ==, 0);
+    g_assert_cmphex(rsp[9], ==, 3);
+    g_assert_cmphex(rsp[11], ==, 0);
+    g_assert_cmphex(rsp[12], ==, 0);
+    g_assert_cmphex(rsp[13], ==, 0); /* Dynamic endpoint, not a bridge. */
+
+    request(qts, SENSOR_ADDR, 0, set_eid, sizeof(set_eid), rsp);
+    g_assert_cmphex(rsp[6], ==, 9);
+    g_assert_cmphex(rsp[11], ==, 0);
+    g_assert_cmphex(rsp[12], ==, 0); /* Accepted. */
+    g_assert_cmphex(rsp[13], ==, 9);
+    g_assert_cmphex(rsp[14], ==, 0); /* No EID pool. */
+
+    request(qts, SENSOR_ADDR, 9, get_types, sizeof(get_types), rsp);
+    g_assert_cmphex(rsp[12], ==, 2);
+    g_assert_cmphex(rsp[13], ==, 0);
+    g_assert_cmphex(rsp[14], ==, 1);
+
+    g_assert_cmpuint(request(qts, SENSOR_ADDR, 9, get_uuid,
+                            sizeof(get_uuid), rsp), ==, 29);
+    memcpy(uuid, rsp + 12, sizeof(uuid));
+    request(qts, SENSOR_ADDR, 9, get_uuid, sizeof(get_uuid), rsp);
+    g_assert_cmpmem(uuid, sizeof(uuid), rsp + 12, sizeof(uuid));
+
+    g_assert_cmpuint(request(qts, SENSOR_ADDR, 9, get_version,
+                            sizeof(get_version), rsp), ==, 18);
+    g_assert_cmphex(rsp[12], ==, 1);
+    g_assert_cmphex(rsp[13], ==, 0xf1);
+    g_assert_cmphex(rsp[14], ==, 0xf3);
+    qtest_quit(qts);
+}
+
+static void test_invalid_requests(void)
+{
+    QTestState *qts = sensor_init();
+    uint8_t rsp[73];
+    uint8_t bad_pec[] = {
+        SENSOR_ADDR << 1, 0x0f, 10, (BMC_ADDR << 1) | 1,
+        1, 0, 8, 0xcd, 0, 0x80, 1, 0, 9, 0,
+    };
+    const uint8_t get_eid[] = { 0, 0x80, 2 };
+    const uint8_t short_set[] = { 0, 0x80, 1, 0 };
+    const uint8_t invalid_eid[] = { 0, 0x80, 1, 0, 7 };
+    const uint8_t assign[] = { 0, 0x80, 1, 0, 9 };
+    const uint8_t reassign[] = { 0, 0x80, 1, 0, 10 };
+    const uint8_t force[] = { 0, 0x80, 1, 1, 10 };
+    const uint8_t reset[] = { 0, 0x80, 1, 2, 0 };
+
+    bad_pec[13] = pec(bad_pec, 13) ^ 1;
+    send_packet(qts, bad_pec, sizeof(bad_pec));
+    /* A subsequent valid request must still work, with EID unassigned. */
+    request(qts, SENSOR_ADDR, 0, get_eid, sizeof(get_eid), rsp);
+    g_assert_cmphex(rsp[12], ==, 0);
+
+    g_assert_cmpuint(request(qts, SENSOR_ADDR, 0, short_set,
+                            sizeof(short_set), rsp), ==, 13);
+    g_assert_cmphex(rsp[11], ==, 3);
+    request(qts, SENSOR_ADDR, 0, invalid_eid, sizeof(invalid_eid), rsp);
+    g_assert_cmphex(rsp[11], ==, 2);
+    g_assert_cmphex(rsp[6], ==, 0);
+
+    request(qts, SENSOR_ADDR, 0, assign, sizeof(assign), rsp);
+    request(qts, SENSOR_ADDR, 0, reassign, sizeof(reassign), rsp);
+    g_assert_cmphex(rsp[12], ==, 0x10);
+    g_assert_cmphex(rsp[13], ==, 9);
+    request(qts, SENSOR_ADDR, 0, force, sizeof(force), rsp);
+    g_assert_cmphex(rsp[12], ==, 0);
+    g_assert_cmphex(rsp[13], ==, 10);
+    request(qts, SENSOR_ADDR, 0, reset, sizeof(reset), rsp);
+    g_assert_cmphex(rsp[13], ==, 0);
+
+    /* No SMBus ARP target responds at the reserved address 0x61. */
+    write_reg(qts, A_I2CD_INTR_STS, 0x7fff);
+    write_reg(qts, A_I2CD_BYTE_BUF, 0x61 << 1);
+    write_reg(qts, A_I2CD_CMD, A_I2CD_M_START_CMD);
+    g_assert_true(read_reg(qts, A_I2CD_INTR_STS) & BIT(1));
+    qtest_quit(qts);
+}
+
+static void test_temperature(void)
+{
+    QTestState *qts = sensor_init();
+    uint8_t rsp[73];
+    const uint8_t get_reading[] = { 1, 0x80, 2, 0x11, 1, 0, 0 };
+    const uint8_t bad_sensor[] = { 1, 0x80, 2, 0x11, 2, 0, 0 };
+    QDict *reply;
+
+    g_assert_cmpuint(request(qts, SENSOR_ADDR, 0, get_reading,
+                            sizeof(get_reading), rsp), ==, 24);
+    g_assert_cmphex(rsp[12], ==, 0);
+    g_assert_cmphex(rsp[13], ==, 5);
+    g_assert_cmpint((int32_t)ldl_le_p(rsp + 19), ==, 35000);
+
+    qtest_qmp_assert_success(qts,
+        "{'execute':'qom-set','arguments':{'path':%s,"
+        "'property':'temperature','value':-12500}}", SENSOR_PATH);
+    reply = qtest_qmp(qts,
+        "{'execute':'qom-get','arguments':{'path':%s,"
+        "'property':'temperature'}}", SENSOR_PATH);
+    g_assert_true(qdict_haskey(reply, "return"));
+    g_assert_cmpint(qdict_get_int(reply, "return"), ==, -12500);
+    qobject_unref(reply);
+    request(qts, 0x1e, 0, get_reading, sizeof(get_reading), rsp);
+    g_assert_cmpint((int32_t)ldl_le_p(rsp + 19), ==, -12500);
+
+    reply = qtest_qmp_assert_failure_ref(qts,
+        "{'execute':'qom-set','arguments':{'path':%s,"
+        "'property':'temperature','value':-273151}}", SENSOR_PATH);
+    qobject_unref(reply);
+    request(qts, 0x1e, 0, get_reading, sizeof(get_reading), rsp);
+    g_assert_cmpint((int32_t)ldl_le_p(rsp + 19), ==, -12500);
+    request(qts, SENSOR_ADDR, 0, bad_sensor, sizeof(bad_sensor), rsp);
+    g_assert_cmphex(rsp[12], ==, 0x80);
+    qtest_quit(qts);
+}
+
+/* Fetch a PDR through the same multipart protocol used by OpenBMC pldmd. */
+static size_t fetch_pdr(QTestState *qts, uint32_t record, uint16_t count,
+                        uint8_t *data, uint32_t *next_record)
+{
+    uint8_t req[17] = { 1, 0x80, 2, 0x51 };
+    uint8_t rsp[73];
+    uint32_t transfer = 0;
+    uint16_t change = 0;
+    size_t total = 0;
+
+    stl_le_p(req + 4, record);
+    stw_le_p(req + 13, count);
+    for (unsigned int part = 0; part < 32; part++) {
+        size_t packet_len;
+        uint16_t received;
+        uint8_t flag;
+
+        stl_le_p(req + 8, transfer);
+        req[12] = part ? 0 : 1; /* GetNextPart / GetFirstPart */
+        stw_le_p(req + 15, change);
+        packet_len = request(qts, SENSOR_ADDR, 9, req, sizeof(req), rsp);
+        g_assert_cmphex(rsp[12], ==, 0);
+        transfer = ldl_le_p(rsp + 17);
+        flag = rsp[21];
+        received = lduw_le_p(rsp + 22);
+        g_assert_cmpuint(received, >, 0);
+        g_assert_cmpuint(received, <=, count);
+        g_assert_cmpuint(total + received, <=, 256);
+        g_assert_cmpuint(packet_len, ==,
+                         25 + received + (flag == 4));
+        g_assert_cmphex(flag, ==,
+                       part ? (transfer ? 1 : 4) : (transfer ? 0 : 5));
+        memcpy(data + total, rsp + 24, received);
+        total += received;
+        if (!part) {
+            g_assert_cmpuint(received, >=, 10);
+            change = lduw_le_p(data + 6);
+        }
+        if (!transfer) {
+            if (flag == 4) {
+                g_assert_cmphex(rsp[24 + received], ==, pec(data, total));
+            }
+            g_assert_cmpuint(total, ==, 10 + lduw_le_p(data + 8));
+            *next_record = ldl_le_p(rsp + 13);
+            return total;
+        }
+    }
+    g_error("GetPDR multipart transfer did not complete");
+}
+
+static void test_pdr_discovery(void)
+{
+    QTestState *qts = sensor_init();
+    const uint8_t assign[] = { 0, 0x80, 1, 0, 9 };
+    const uint8_t set_tid[] = { 1, 0x80, 0, 1, 7 };
+    const uint8_t get_commands[] = { 1, 0x80, 0, 5, 2, 0, 0xf0, 0xf0, 0xf1 };
+    const uint8_t get_info[] = { 1, 0x80, 2, 0x50 };
+    uint8_t rsp[73], pdr[256], numeric[256];
+    uint32_t record = 0, next, repository_size, largest_record;
+    size_t total = 0, numeric_len = 0, largest = 0;
+    unsigned int records = 0;
+
+    request(qts, SENSOR_ADDR, 0, assign, sizeof(assign), rsp);
+    request(qts, SENSOR_ADDR, 9, set_tid, sizeof(set_tid), rsp);
+    request(qts, SENSOR_ADDR, 9, get_commands, sizeof(get_commands), rsp);
+    g_assert_cmphex(rsp[12], ==, 0);
+    g_assert_true(rsp[15] & BIT(1)); /* GetSensorReading */
+    g_assert_cmphex(rsp[23] & 3, ==, 3); /* GetPDRRepositoryInfo and GetPDR */
+    g_assert_cmpuint(request(qts, SENSOR_ADDR, 9, get_info,
+                            sizeof(get_info), rsp), ==, 54);
+    g_assert_cmphex(rsp[12], ==, 0);
+    g_assert_cmphex(rsp[13], ==, 0); /* Repository available */
+    g_assert_cmpuint(ldl_le_p(rsp + 40), ==, 4);
+    repository_size = ldl_le_p(rsp + 44);
+    largest_record = ldl_le_p(rsp + 48);
+
+    do {
+        size_t len = fetch_pdr(qts, record, UINT16_MAX, pdr, &next);
+
+        total += len;
+        largest = MAX(largest, len);
+        records++;
+        g_assert_cmpuint(records, <=, 4);
+        switch (pdr[5]) {
+        case 1: /* Terminus Locator: reflects assigned EID and PLDM TID. */
+            g_assert_cmphex(pdr[12], ==, 1);
+            g_assert_cmphex(pdr[13], ==, 7);
+            g_assert_cmphex(pdr[18], ==, 9);
+            break;
+        case 2: /* Numeric Sensor: signed milli-degrees Celsius. */
+            g_assert_cmpuint(lduw_le_p(pdr + 12), ==, 1);
+            g_assert_cmphex(pdr[21], ==, 1);
+            g_assert_cmphex(pdr[22], ==, 2);
+            g_assert_cmpint((int8_t)pdr[23], ==, -3);
+            g_assert_cmphex(pdr[32], ==, 5);
+            g_assert_cmphex(ldl_le_p(pdr + 33), ==, 0x3f800000);
+            g_assert_cmpint((int32_t)ldl_le_p(pdr + 59), ==, 128000);
+            g_assert_cmpint((int32_t)ldl_le_p(pdr + 63), ==, -127000);
+            numeric_len = len;
+            memcpy(numeric, pdr, len);
+            break;
+        case 6: /* Sensor name is a terminated UTF-16BE string. */
+            g_assert_cmpuint(lduw_le_p(pdr + 12), ==, 1);
+            g_assert_cmpmem(pdr + 16, 3, "en", 3);
+            g_assert_cmpmem(pdr + 19, 24,
+                           "\0T\0e\0m\0p\0e\0r\0a\0t\0u\0r\0e\0", 24);
+            break;
+        case 16: /* The root entity name gives pldmd a valid D-Bus path. */
+            g_assert_cmpuint(lduw_le_p(pdr + 14), ==, 0);
+            g_assert_cmpmem(pdr + 18, 3, "en", 3);
+            g_assert_cmpmem(pdr + 21, 26,
+                           "\0Q\0E\0M\0U\0_\0M\0C\0T\0P\0_\0" "1\0d\0", 26);
+            break;
+        default:
+            g_assert_not_reached();
+        }
+        record = next;
+    } while (record);
+    g_assert_cmpuint(records, ==, 4);
+    g_assert_cmpuint(total, ==, repository_size);
+    g_assert_cmpuint(largest, ==, largest_record);
+    g_assert_cmpuint(numeric_len, >, 47);
+
+    /* Small requester buffers exercise intermediate parts and final CRC. */
+    g_assert_cmpuint(fetch_pdr(qts, 2, 13, pdr, &next), ==, numeric_len);
+    g_assert_cmpmem(pdr, numeric_len, numeric, numeric_len);
+    g_assert_cmpuint(next, ==, 3);
+    qtest_quit(qts);
+}
+
+static void test_pdr_invalid_requests(void)
+{
+    QTestState *qts = sensor_init();
+    const uint8_t assign[] = { 0, 0x80, 1, 0, 9 };
+    const uint8_t set_tid[] = { 1, 0x80, 0, 1, 2 };
+    const uint8_t long_info[] = { 1, 0x80, 2, 0x50, 0 };
+    uint8_t req[17] = { 1, 0x80, 2, 0x51 };
+    uint8_t rsp[73];
+    uint32_t transfer;
+    uint16_t change;
+
+    request(qts, SENSOR_ADDR, 0, assign, sizeof(assign), rsp);
+    req[12] = 1;
+    stw_le_p(req + 13, UINT16_MAX);
+    request(qts, SENSOR_ADDR, 9, req, sizeof(req) - 1, rsp);
+    g_assert_cmphex(rsp[12], ==, 3);
+    request(qts, SENSOR_ADDR, 9, long_info, sizeof(long_info), rsp);
+    g_assert_cmphex(rsp[12], ==, 3);
+
+    stl_le_p(req + 4, 99);
+    request(qts, SENSOR_ADDR, 9, req, sizeof(req), rsp);
+    g_assert_cmphex(rsp[12], ==, 0x82);
+    stl_le_p(req + 4, 2);
+    req[12] = 2;
+    request(qts, SENSOR_ADDR, 9, req, sizeof(req), rsp);
+    g_assert_cmphex(rsp[12], ==, 0x81);
+    req[12] = 1;
+    stl_le_p(req + 8, 1);
+    request(qts, SENSOR_ADDR, 9, req, sizeof(req), rsp);
+    g_assert_cmphex(rsp[12], ==, 0x80);
+
+    stl_le_p(req + 8, 0);
+    request(qts, SENSOR_ADDR, 9, req, sizeof(req), rsp);
+    g_assert_cmphex(rsp[12], ==, 0);
+    g_assert_cmphex(rsp[21], ==, 0); /* Start of a multipart Numeric PDR */
+    transfer = ldl_le_p(rsp + 17);
+    change = lduw_le_p(rsp + 30);
+    req[12] = 0;
+    stl_le_p(req + 8, transfer);
+    stw_le_p(req + 15, change + 1);
+    request(qts, SENSOR_ADDR, 9, req, sizeof(req), rsp);
+    g_assert_cmphex(rsp[12], ==, 0x83);
+
+    stw_le_p(req + 15, change);
+    stl_le_p(req + 4, 3); /* A continuation cannot be reused for another PDR. */
+    request(qts, SENSOR_ADDR, 9, req, sizeof(req), rsp);
+    g_assert_cmphex(rsp[12], ==, 0x80);
+    stl_le_p(req + 4, 2);
+    stl_le_p(req + 8, (transfer & ~0xffU) | 0xff);
+    request(qts, SENSOR_ADDR, 9, req, sizeof(req), rsp);
+    g_assert_cmphex(rsp[12], ==, 0x80);
+
+    /* Changing the locator invalidates an in-progress repository generation. */
+    stl_le_p(req + 8, transfer);
+    request(qts, SENSOR_ADDR, 9, set_tid, sizeof(set_tid), rsp);
+    request(qts, SENSOR_ADDR, 9, req, sizeof(req), rsp);
+    g_assert_cmphex(rsp[12], ==, 0x83);
+
+    /* A zero requestCount is legal and returns no record bytes. */
+    stl_le_p(req + 4, 0);
+    stl_le_p(req + 8, 0);
+    req[12] = 1;
+    stw_le_p(req + 13, 0);
+    stw_le_p(req + 15, 0);
+    g_assert_cmpuint(request(qts, SENSOR_ADDR, 9, req,
+                            sizeof(req), rsp), ==, 25);
+    g_assert_cmphex(rsp[12], ==, 0);
+    g_assert_cmphex(rsp[21], ==, 5);
+    g_assert_cmpuint(lduw_le_p(rsp + 22), ==, 0);
+    g_assert_cmpuint(ldl_le_p(rsp + 17), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/mctp-i2c-sensor/setup-endpoint", test_setup_endpoint);
+    qtest_add_func("/mctp-i2c-sensor/invalid-requests", test_invalid_requests);
+    qtest_add_func("/mctp-i2c-sensor/temperature", test_temperature);
+    qtest_add_func("/mctp-i2c-sensor/pdr-discovery", test_pdr_discovery);
+    qtest_add_func("/mctp-i2c-sensor/pdr-invalid-requests",
+                   test_pdr_invalid_requests);
+    return g_test_run();
+}
